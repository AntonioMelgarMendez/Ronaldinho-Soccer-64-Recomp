# Linux -> Windows x64 using clang-cl, lld and an xwin SDK.
# Set ISS64_LLVM_BIN and ISS64_WINSDK in the environment before configuring.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_C_COMPILER "$ENV{ISS64_LLVM_BIN}/clang-cl")
set(CMAKE_CXX_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_LINKER "$ENV{ISS64_LLVM_BIN}/lld-link")
set(CMAKE_AR "$ENV{ISS64_LLVM_BIN}/llvm-lib")
set(CMAKE_RC_COMPILER "$ENV{ISS64_LLVM_BIN}/llvm-rc")
set(CMAKE_MT "$ENV{ISS64_LLVM_BIN}/llvm-mt")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)

set(_sdk "$ENV{ISS64_WINSDK}")
if(NOT EXISTS "${_sdk}/crt/include" OR NOT EXISTS "${_sdk}/sdk/include/um")
    message(FATAL_ERROR "ISS64_WINSDK must point to an xwin splat directory")
endif()
set(_includes "-imsvc ${_sdk}/crt/include -imsvc ${_sdk}/sdk/include/ucrt -imsvc ${_sdk}/sdk/include/shared -imsvc ${_sdk}/sdk/include/um -imsvc ${_sdk}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${_includes}")
set(CMAKE_CXX_FLAGS_INIT "${_includes} /EHsc")
set(_libs "/libpath:${_sdk}/crt/lib/x86_64 /libpath:${_sdk}/sdk/lib/ucrt/x86_64 /libpath:${_sdk}/sdk/lib/um/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_libs} /MANIFEST:NO")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_libs} /MANIFEST:NO")
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(CMAKE_FIND_ROOT_PATH "${_sdk}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
